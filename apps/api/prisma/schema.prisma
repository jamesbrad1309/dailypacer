generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Habit {
  id          String    @id @default(uuid())
  name        String
  /// Free-text "why / how" shown under the name on the dashboard card.
  description String?
  /// Lowercased, de-duplicated labels ("health", "morning") for filtering.
  tags        String[]  @default([])
  icon        String?
  color       String?
  unit        String?
  targetValue Float?
  /// "HH:mm" (24h, local time) — when this habit is meant to happen in the
  /// day, for the day-calendar view. Null means "anytime today".
  startTime   String?
  schedule    Json
  metadata    Json      @default("{}")
  archivedAt  DateTime?
  pausedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries HabitEntry[]
  pauses  HabitPause[]

  @@map("habits")
}

/// A stretch a habit was paused, in the user's local days. Paused days aren't
/// due: they neither break a streak nor count as missed.
model HabitPause {
  id        String    @id @default(uuid())
  habitId   String
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  /// The first paused day.
  startDate DateTime  @db.Date
  /// The day it was resumed (active again from that day); null while still paused.
  endDate   DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@index([habitId])
  @@map("habit_pauses")
}

model HabitEntry {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Float?
  completed Boolean  @default(false)
  note      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@map("habit_entries")
}

enum JournalEntryKind {
  ACTION
  FEELING
  EVENT
}

enum JournalTone {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

/// One item in a day's journal: something the user did (ACTION), felt
/// (FEELING) or that happened to them (EVENT). Kind-specific columns are
/// null for the other kinds — see journal/dto/journal-entry.dto.ts.
model JournalEntry {
  id              String           @id @default(uuid())
  date            DateTime         @db.Date
  kind            JournalEntryKind
  /// "HH:mm" (24h, local time) it happened; null means "sometime that day".
  time            String?
  text            String           @default("")
  /// #tags parsed out of `text`, lowercased, for filtering.
  tags            String[]         @default([])
  /// ACTION only.
  durationMinutes Int?
  /// FEELING only — an emotion word from the frontend's emotion list.
  emotion         String?
  /// FEELING only — 1 (faint) to 5 (overwhelming).
  intensity       Int?
  /// EVENT only.
  tone            JournalTone?
  /// The EVENT that prompted this feeling or action ("because of …").
  triggerId       String?
  trigger         JournalEntry?    @relation("JournalTrigger", fields: [triggerId], references: [id], onDelete: SetNull)
  triggered       JournalEntry[]   @relation("JournalTrigger")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([date])
  @@map("journal_entries")
}

// ─── Finance ─────────────────────────────────────────────────────────────────
// All amounts are integer minor units (pence): see docs/finance/money-handling.md.
// Subscriptions, savings goals and payee rules are at the end of this section.

enum AccountType {
  CURRENT
  SAVINGS
  CREDIT_CARD
  LOAN
  /// Personal debt with a person: + = they owe you, − = you owe them.
  IOU
  CASH
  INVESTMENT
}

/// Anywhere money lives or is owed. One table for every type, with nullable
/// type-specific columns; finance/dto/account.dto.ts decides which apply.
model Account {
  id                  String      @id @default(uuid())
  name                String
  type                AccountType
  currency            String      @default("GBP") // ISO 4217
  /// Bank or lender name, or the person for an IOU.
  institution         String?
  /// Display only, never a full card number.
  last4               String?
  icon                String?
  color               String?
  sortOrder           Int         @default(0)
  /// At most one (unarchived) account is the default; quick log uses it when
  /// none is chosen. A partial unique index enforces it (see the migration).
  isDefault           Boolean     @default(false)

  /// Balance on the day tracking started. Owed amounts are stored negative.
  openingBalanceMinor Int         @default(0)
  openingBalanceDate  DateTime    @db.Date
  lastReconciledAt    DateTime?

  // Credit card
  creditLimitMinor    Int?
  /// 1–31, clamped to the month's length.
  statementDay        Int?
  paymentDueDay       Int?
  minPaymentMinor     Int?

  // Credit card + loan
  /// APR in basis points: 1999 = 19.99%.
  aprBps              Int?

  // Loan
  monthlyPaymentMinor Int?
  loanStartDate       DateTime?   @db.Date
  termMonths          Int?

  // IOU
  dueDate             DateTime?   @db.Date

  archivedAt          DateTime?
  metadata            Json        @default("{}")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  transactions  Transaction[]
  presets       QuickPreset[]
  monthlyTotals MonthlyTotal[]
  subscriptions Subscription[]
  savingsGoals  SavingsGoal[]

  @@map("accounts")
}

model Category {
  id         String     @id @default(uuid())
  name       String
  icon       String?
  color      String?
  /// "expense" | "income"
  kind       String     @default("expense")
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  archivedAt DateTime?
  /// Built-in categories ("Adjustment") that reports ignore and users can't delete.
  isSystem   Boolean    @default(false)
  /// { aliases: string[] } for the quick-log parser; { dismissedPresetSuggestions: string[] }.
  metadata   Json       @default("{}")
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())

  transactions  Transaction[]
  presets       QuickPreset[]
  monthlyTotals MonthlyTotal[]
  budgets       Budget[]
  subscriptions Subscription[]
  splits        TransactionSplit[]
  payeeRules    PayeeRule[]

  @@unique([parentId, name])
  @@map("categories")
}

enum TransactionStatus {
  /// Gone through: the default.
  CLEARED
  /// Expected but not confirmed yet (an auto-logged bill, a card hold). Counts
  /// in balances and reports like any other, and waits in "To review" until
  /// confirmed.
  PENDING
}

model Transaction {
  id          String    @id @default(uuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date        DateTime  @db.Date
  /// Negative = money out of the account.
  amountMinor Int
  payee       String?
  note        String?
  tags        String[]  @default([])
  /// Both legs of a transfer share this id; excluded from income/expense reports.
  transferId  String?
  /// Hash of (account, date, amount, payee) for CSV-import dedupe.
  importHash  String?
  /// Client-generated id from quick log; makes retries and double taps idempotent.
  clientId    String?   @unique
  /// "quick" | "form" | "import" | "recurring" | "adjustment" | "transfer"
  source      String    @default("form")
  status      TransactionStatus @default(CLEARED)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Set when this transaction is a confirmed subscription charge.
  subscriptionCharge SubscriptionCharge?
  /// Split across categories: then `categoryId` is null and these say where
  /// the money went; they always add up to `amountMinor`.
  splits             TransactionSplit[]

  @@unique([accountId, importHash])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([transferId])
  @@index([status])
  @@map("transactions")
}

/// One part of a split transaction ("£40 groceries + £12 household" on one
/// receipt). Same sign as the transaction; monthly totals count each part
/// in its own category (MonthlyTotalsService).
model TransactionSplit {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Restrict, like monthly totals: categories are archived, never deleted.
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountMinor   Int
  note          String?
  position      Int         @default(0)

  @@index([transactionId])
  @@index([categoryId])
  @@map("transaction_splits")
}

/// A one-tap quick-log button: "☕ Flat white £3.40". Without an amount it
/// opens the keypad with the category already chosen.
model QuickPreset {
  id          String    @id @default(uuid())
  label       String
  emoji       String?
  amountMinor Int?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Null → the default account.
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payee       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("quick_presets")
}

/// Pre-aggregated money in and out per (month, account, category), kept in
/// step with `transactions` inside the same database transaction as every
/// write (finance/monthly-totals.service.ts), so reports read a few rows
/// instead of scanning transactions. Transfers and balance adjustments are
/// not counted. The migration adds what Prisma can't express: a unique key
/// on (month, accountId, categoryId) with NULLS NOT DISTINCT (a null
/// category is the "To review" bucket) and CHECKs that no total goes negative.
model MonthlyTotal {
  id               String    @id @default(uuid())
  /// Always the 1st of the month.
  month            DateTime  @db.Date
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Null: uncategorised. Categories are archived, never deleted, so a
  /// delete that would orphan totals is refused rather than merged.
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Money out, as a positive amount.
  outflowMinor     Int       @default(0)
  /// Money in (income, refunds).
  inflowMinor      Int       @default(0)
  transactionCount Int       @default(0)
  updatedAt        DateTime  @updatedAt

  /// Declared so `prisma migrate dev` treats the index as expected instead of
  /// dropping it as drift. The real index is NULLS NOT DISTINCT, which Prisma
  /// can't express: it's created by hand in the migrations, and
  /// MonthlyTotalsService checks it on startup.
  @@unique([month, accountId, categoryId], map: "monthly_totals_key")
  @@index([month])
  @@map("monthly_totals")
}

/// A monthly spending limit for a category, **from `month` onwards**: the
/// limit for any month is the latest row at or before it, so a budget is set
/// once and carries forward, while past months keep the limit they had.
/// A row with `amountMinor = null` ends the budget from that month.
model Budget {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Always the 1st of the month the change takes effect.
  month       DateTime @db.Date
  /// Positive limit; null = no budget from this month on.
  amountMinor Int?
  /// Carry last month's unspent amount into this one (never an overspend).
  rollover    Boolean  @default(false)
  /// ISO 4217: the main currency when the limit was set. Reports convert it
  /// to the current main currency, so changing the main one doesn't turn a
  /// £250 budget into ₫250.
  currency    String   @default("GBP")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, month])
  @@map("budgets")
}

/// The currencies the user works in. Exactly one is the main currency that
/// totals are converted into (a partial unique index enforces it, see the
/// migration). Accounts pick their currency from this list.
model Currency {
  /// ISO 4217, e.g. "GBP", "VND".
  code           String   @id
  isMain         Boolean  @default(false)
  sortOrder      Int      @default(0)
  /// The user's own rate, in main-currency units per 1 unit of this one; it
  /// replaces the fetched rate. Cleared when the main currency changes.
  overrideToMain Float?
  createdAt      DateTime @default(now())

  @@map("currencies")
}

/// Daily exchange rates, as units of `code` per 1 USD (the providers' pivot),
/// so any pair converts via USD. One row per day fetched; past months
/// convert at the rate of their time.
model ExchangeRate {
  date      DateTime @db.Date
  code      String
  perUsd    Float
  /// Which provider it came from, for attribution and debugging.
  source    String
  fetchedAt DateTime @default(now())

  @@id([date, code])
  @@index([code, date])
  @@map("exchange_rates")
}

// ─── Subscriptions ───────────────────────────────────────────────────────────
// Repeating charges the user confirms one at a time: nothing reaches an
// account until a due charge is confirmed, which creates a real transaction.
// Charge dates are computed from the schedule (finance/subscription-schedule.util.ts),
// never stored ahead of time. See docs/finance/subscriptions.md.

enum BillingInterval {
  WEEK
  MONTH
  YEAR
}

model Subscription {
  id            String          @id @default(uuid())
  name          String
  /// Built-in catalog key ("netflix", finance/subscription-catalog.ts); null for a custom service.
  serviceKey    String?
  /// The website its logo comes from: "netflix.com".
  domain        String?
  /// Money in (a salary) rather than a charge: confirmed amounts are positive
  /// and it's left out of the cost totals.
  isIncome      Boolean         @default(false)
  /// Log each charge by itself on its date, as a PENDING transaction, instead
  /// of asking first. The user then confirms it once it has gone through.
  autoLog       Boolean         @default(false)
  /// The last day auto-logging has run up to, so it never logs a date twice
  /// (and an auto-logged transaction the user deleted stays deleted).
  autoLoggedThrough DateTime?   @db.Date
  /// Where charges are taken from; amounts are in this account's currency.
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Every `intervalCount` weeks, months or years.
  interval      BillingInterval @default(MONTH)
  intervalCount Int             @default(1)
  /// A charge date every later one counts from (after any free trial). The
  /// 31st in a short month falls on its last day.
  firstChargeOn DateTime        @db.Date
  /// Display only: "trial ends in 3 days, then £9.99/mo".
  trialEndsOn   DateTime?       @db.Date
  /// Charges due before this day are never asked about: the day it was
  /// added, resumed or reactivated. Keeps an old subscription from asking
  /// about years of past charges.
  askFrom       DateTime        @db.Date
  /// Paused: no charges are due until it's resumed.
  pausedAt      DateTime?
  /// Cancelled: no charges on or after this day. Can be in the future
  /// ("cancelled, runs until 15 Oct").
  endsOn        DateTime?       @db.Date
  note          String?
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  prices  SubscriptionPrice[]
  charges SubscriptionCharge[]

  @@map("subscriptions")
}

/// Price history: a charge costs the price in effect on its date, so a
/// price rise can be entered ahead of time.
model SubscriptionPrice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Positive, in the account's currency.
  amountMinor    Int
  effectiveFrom  DateTime     @db.Date
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, effectiveFrom])
  @@map("subscription_prices")
}

enum ChargeOutcome {
  CONFIRMED
  SKIPPED
}

/// A due charge the user has answered. Due charges without a row are pending.
model SubscriptionCharge {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  dueOn          DateTime      @db.Date
  outcome        ChargeOutcome
  /// The transaction a confirmation created. Deleting it (e.g. Undo) deletes
  /// this row too, so the charge is pending again.
  transactionId  String?       @unique
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([subscriptionId, dueOn])
  @@map("subscription_charges")
}

/// Each service's icon, fetched once from a favicon service and kept here so
/// the browser never calls a third party. `data` is null when no provider had
/// one; that's retried after a week (finance/logos.service.ts).
model ServiceLogo {
  domain      String   @id
  data        Bytes?
  contentType String?
  fetchedAt   DateTime @default(now())

  @@map("service_logos")
}

// ─── To-do lists ─────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// A list of tasks with a short key prefix: "Grocery list" / GRO → GRO-1, GRO-2…
model TodoList {
  id         String    @id @default(uuid())
  name       String
  /// 2–6 uppercase letters/digits, unique. Renaming it re-keys every task at
  /// once: keys are shown as "<prefix>-<number>", never stored.
  prefix     String    @unique
  /// The number the next task added to (or moved into) this list gets. Only
  /// ever goes up, so a number is never reused, even after a delete.
  nextNumber Int       @default(1)
  /// The Inbox can't be deleted: tasks added without a list go there.
  isInbox    Boolean   @default(false)
  position   Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tasks   Task[]
  columns TodoColumn[]

  @@map("todo_lists")
}

/// A board column. Each maps to a status (its category): a task's status is
/// always its column's, so "done", Today and "blocked" work whatever the
/// columns are called. Every list keeps at least one column per status.
model TodoColumn {
  id        String     @id @default(uuid())
  listId    String
  list      TodoList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Null shows the status's own (translated) name: "To do", "In progress", "Done".
  name      String?
  status    TaskStatus
  /// Left-to-right order on the board.
  position  Float      @default(0)
  createdAt DateTime   @default(now())

  tasks Task[]

  @@index([listId, position])
  @@map("todo_columns")
}

model Task {
  id          String     @id @default(uuid())
  listId      String
  list        TodoList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Fixed while the task stays in its list; moving it takes the new list's next number.
  number      Int
  title       String
  notes       String?
  /// Always the column's status (TodosService keeps them in step).
  status      TaskStatus @default(TODO)
  /// Its board column, in the same list. NoAction (checked at the end of the
  /// statement) so deleting a list can cascade to both columns and tasks.
  columnId    String
  column      TodoColumn @relation(fields: [columnId], references: [id], onDelete: NoAction)
  /// Order within its board column (fractional, so a drag updates one row).
  position    Float      @default(0)
  /// The day it's planned for (user's local day), from any list; null = not planned.
  plannedFor  DateTime?  @db.Date
  /// Order within its planned day, for Today (fractional, like `position`).
  dayPosition Float      @default(0)
  /// The deadline, separate from when it's planned: "due Friday, doing it Thursday".
  dueOn       DateTime?  @db.Date
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// Tasks this one waits for (it's blocked until they're all done).
  blockedBy TaskDependency[] @relation("blockedBy")
  /// Tasks waiting for this one.
  blocks    TaskDependency[] @relation("blocks")

  @@unique([listId, number])
  @@index([plannedFor])
  @@index([listId, status, position])
  @@index([columnId, position])
  @@index([dueOn])
  @@map("tasks")
}

/// "task waits for dependsOn". Either side can be in any list; no cycles
/// (checked by TodosService). Deleting either task removes the link.
model TaskDependency {
  taskId      String
  task        Task     @relation("blockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("blocks", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

// ─── Savings goals ───────────────────────────────────────────────────────────

/// Money put aside for something. Linked to an account, that account's
/// balance is what's saved; otherwise `savedMinor` is, added to by hand.
/// Progress, "on track" and the monthly amount needed are derived on read
/// (finance/savings-goal.util.ts).
model SavingsGoal {
  id               String    @id @default(uuid())
  name             String
  emoji            String?
  /// Positive, in `currency`.
  targetMinor      Int
  /// ISO 4217: the linked account's currency, else the main one when created.
  currency         String
  deadline         DateTime? @db.Date
  accountId        String?
  account          Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Unlinked goals only: what's been put aside so far.
  savedMinor       Int       @default(0)
  /// "On track" compares progress since this day with the time gone since it.
  startDate        DateTime  @db.Date
  /// What was saved on `startDate` (a linked account may not start at zero).
  startSavedMinor  Int       @default(0)
  sortOrder        Int       @default(0)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("savings_goals")
}

// ─── Payee rules ─────────────────────────────────────────────────────────────

/// "TESCO*" → Groceries: rules the user writes, tried before payee history
/// and category names when quick log, CSV import or "Apply rules" files a
/// transaction (finance/payee-rule.util.ts). Lower `sortOrder` wins.
model PayeeRule {
  id         String   @id @default(uuid())
  /// `*` matches anything; without one it matches anywhere in the payee.
  /// Case, accents and spacing don't matter.
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("payee_rules")
}
