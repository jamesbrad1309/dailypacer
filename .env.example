DATABASE_URL=postgres://dailypacer:dailypacer@localhost:5433/dailypacer
API_PORT=3000
# GraphQL BFF (apps/bff): the only backend the browser talks to
BFF_PORT=4000
# Where the BFF reaches the internal REST API
API_URL=http://localhost:3000
WEB_PORT=5173
NODE_ENV=development
# Sign-in (docs/backend/auth.md). The API creates this owner on every start if
# the account doesn't exist. These are the defaults; change them for anything
# reachable by others.
# OWNER_EMAIL=admin@dailypacer.local
# OWNER_PASSWORD=dailypaceradmin123
# OWNER_NAME=Admin
# The session cookie's Secure flag: auto (only over HTTPS) | true | false
# SESSION_COOKIE_SECURE=auto
# LOG_LEVEL=debug   # trace|debug|info|warn|error|fatal — defaults to debug (dev) / info (prod)
